{
  // Scale Explorer is a static site served by Cloudflare Workers static assets.
  // There is no Worker script: every file in ./public is served as-is.
  // ./public is generated from data/ and src/ by build/build.mjs, which runs
  // automatically before `npx wrangler deploy` and `npx wrangler dev`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scale-explorer",
  "compatibility_date": "2026-09-20",
  "build": {
    "command": "node build/build.mjs"
  },
  "assets": {
    "directory": "./public",
    // /objects/blue-whale serves objects/blue-whale.html (no trailing slash).
    "html_handling": "auto-trailing-slash",
    // Unknown paths get public/404.html with a 404 status.
    "not_found_handling": "404-page"
  }
}
